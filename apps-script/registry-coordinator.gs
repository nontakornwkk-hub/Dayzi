function doPost(e){var lock=LockService.getScriptLock();try{var p=JSON.parse(e.postData.contents||'{}');var props=PropertiesService.getScriptProperties();if(!p.secret||p.secret!==registrySecret_(props))return output_({error:'Unauthorized',status:401});if(!lock.tryLock(15000))return output_({error:'ระบบกำลังบันทึกข้อมูล กรุณาลองใหม่',status:503});var ss=registryBook_(props),sheet=ss.getSheetByName('registry');if(!sheet){sheet=ss.insertSheet('registry');sheet.appendRow(['user_id','json']);}var vals=sheet.getDataRange().getValues(),accounts=[];for(var i=1;i<vals.length;i++){if(vals[i][0])accounts.push({row:i+1,account:JSON.parse(vals[i][1])});}var found=accounts.filter(function(x){return x.account.uid===p.uid;})[0];var a=found?found.account:{uid:p.uid,version:0,revision:0,uploads:[]};var now=Date.now();
function save(){var row=found?found.row:sheet.getLastRow()+1;sheet.getRange(row,1,1,2).setValues([[p.uid,JSON.stringify(a)]]);SpreadsheetApp.flush();return a;}
function current(){if(!a.connection||a.connection.status!=='ready'||a.version!==p.connectionVersion)throw {message:'การเชื่อมต่อเปลี่ยนแล้ว กรุณารีเฟรช',status:409};}
function reserve(){accounts.forEach(function(x){if(x.account.uid===p.uid)return;var c=x.account.connection,r=x.account.reservation;if(c&&c.status==='ready'&&(c.spreadsheetId===p.ids.spreadsheetId||c.folderId===p.ids.folderId))throw {message:'พื้นที่นี้เชื่อมกับบัญชีอื่นในระบบแล้ว',status:409};if(r&&r.expires>now&&(r.spreadsheetId===p.ids.spreadsheetId||r.folderId===p.ids.folderId))throw {message:'พื้นที่นี้กำลังตั้งค่าโดยบัญชีอื่น',status:409};});a.reservation={spreadsheetId:p.ids.spreadsheetId,folderId:p.ids.folderId,expires:now+900000};}
var action=p.action;
if(action==='get')return output_(found?a:null);
if(action==='list')return output_(accounts.map(function(x){return x.account;}).filter(function(x){return x.connection&&x.connection.status==='ready';}).slice(0,30));
if(action==='oauth'){a.email=p.email;a.name=p.name;if(p.encryptedToken)a.encryptedToken=p.encryptedToken;save();return output_({ok:true});}
if(action==='lineOnboard'){if(!/^U[0-9a-f]{32}$/i.test(p.lineId||'')||p.uid!=='line:'+p.lineId)throw {message:'LINE identity mismatch',status:403};if(a.connection&&a.connection.status==='ready'){if(a.authProvider!=='line'||a.line!==p.lineId)throw {message:'LINE account mismatch',status:403};if(p.name)a.name=String(p.name).slice(0,100);save();return output_(a);}if(props.getProperty('LEGACY_OWNER_STORAGE')!=='1'){a.authProvider='line';a.line=p.lineId;if(p.name)a.name=String(p.name).slice(0,100);save();return output_(a);}var rootId=props.getProperty('STORAGE_ROOT_FOLDER_ID');var root=rootId?DriveApp.getFolderById(rootId):DriveApp.createFolder('Dayzi user spaces');if(!rootId)props.setProperty('STORAGE_ROOT_FOLDER_ID',root.getId());var workspace=root.createFolder('LINE-'+p.lineId.slice(-8)),filesFolder=workspace.createFolder('Files'),book=SpreadsheetApp.create('Dayzi - '+p.lineId.slice(-8));DriveApp.getFileById(book.getId()).moveTo(workspace);var schemas=dayziSchemas_();Object.keys(schemas).forEach(function(name){var tab=book.insertSheet(name);tab.getRange(1,1,1,schemas[name].length).setValues([schemas[name]]);});book.getSheetByName('app_meta').getRange(2,1,1,2).setValues([['schema_version','2']]);book.getSheetByName('settings').getRange(2,1,3,2).setValues([['name',JSON.stringify(String(p.name||'คุณ'))],['quietStart',JSON.stringify('22:00')],['quietEnd',JSON.stringify('07:00')]]);a.authProvider='line';a.line=p.lineId;a.name=String(p.name||'คุณ').slice(0,100);a.version++;a.revision=0;a.sizes={};a.uploads=[];a.connection={spreadsheetId:book.getId(),folderId:filesFolder.getId(),status:'ready',spreadsheetUrl:'https://docs.google.com/spreadsheets/d/'+book.getId()+'/edit',driveFolderUrl:'https://drive.google.com/drive/folders/'+filesFolder.getId()};save();return output_(a);}
if(action==='linkGoogle'){if(!/^line:U[0-9a-f]{32}$/i.test(p.uid||''))throw {message:'LINE identity mismatch',status:403};if(a.authProvider&&a.authProvider!=='line')throw {message:'Not a LINE account',status:403};if(typeof p.encryptedToken!=='string'||!p.encryptedToken||!p.ids||typeof p.ids.spreadsheetId!=='string'||typeof p.ids.folderId!=='string')throw {message:'Invalid link',status:400};reserve();a.authProvider='line';a.line=p.uid.slice(5);a.email=String(p.email||'').slice(0,200);a.encryptedToken=p.encryptedToken;a.version++;a.revision=0;a.sizes={};a.uploads=[];a.connection={spreadsheetId:p.ids.spreadsheetId,folderId:p.ids.folderId,status:'ready',spreadsheetUrl:p.sheetUrl,driveFolderUrl:p.folderUrl,auth:'oauth'};a.reservation=null;save();return output_(a);}
if(action==='ownerToken'){current();if(a.authProvider!=='line')throw {message:'Not a system-managed account',status:403};return output_({accessToken:ScriptApp.getOAuthToken()});}
if(action==='chatHistory'){current();a.chatHistory=p.encryptedHistory;save();return output_({ok:true});}
if(action==='reserve'){reserve();save();return output_({ok:true});}
if(action==='connect'){if(a.version!==p.expectedVersion)throw {message:'ข้อมูลเปลี่ยนแล้ว กรุณารีเฟรช',status:409};reserve();var same=a.connection&&a.connection.spreadsheetId===p.ids.spreadsheetId&&a.connection.folderId===p.ids.folderId;a.version++;a.connection={spreadsheetId:p.ids.spreadsheetId,folderId:p.ids.folderId,status:'ready',spreadsheetUrl:p.sheetUrl,driveFolderUrl:p.folderUrl,auth:p.auth==='service'?'service':null};if(!same){a.revision=0;a.sizes={};a.uploads=[];}a.reservation=null;save();return output_({ok:true,version:a.version});}
if(action==='disconnect'){if(a.version!==p.expectedVersion)throw {message:'ข้อมูลเปลี่ยนแล้ว กรุณารีเฟรช',status:409};a.version++;if(a.connection)a.connection.status='disconnected';a.encryptedToken=null;a.push=null;a.line=null;a.reservation=null;save();return output_({ok:true});}
if(action==='logout')return output_({ok:true});
if(action==='registerUpload'){current();a.uploads=(a.uploads||[]).concat([p.file]).slice(-1000);save();return output_({ok:true});}
if(action==='saveChat'){current();return output_(saveChat_(a,p));}
if(action==='saveData'){current();if(a.revision!==p.expectedRevision)throw {message:'ข้อมูลถูกแก้ไขจากอีกอุปกรณ์ กรุณารีเฟรช',status:409};var names=Object.keys(p.ranges);names.forEach(function(n){if(!/^(app_meta|events|tasks|notes|files|transactions|settings|reminders)$/.test(n))throw {message:'Invalid table',status:400};});if(names.indexOf('transactions')>=0){var metaRes=UrlFetchApp.fetch('https://sheets.googleapis.com/v4/spreadsheets/'+a.connection.spreadsheetId+'?fields=sheets(properties(title))',{headers:{Authorization:'Bearer '+p.accessToken},muteHttpExceptions:true});if(metaRes.getResponseCode()>=300)throw {message:'ตรวจตารางรายรับรายจ่ายไม่สำเร็จ',status:503};var meta=JSON.parse(metaRes.getContentText());if(!(meta.sheets||[]).some(function(s){return s.properties.title==='transactions';})){var createRes=UrlFetchApp.fetch('https://sheets.googleapis.com/v4/spreadsheets/'+a.connection.spreadsheetId+':batchUpdate',{method:'post',contentType:'application/json',headers:{Authorization:'Bearer '+p.accessToken},payload:JSON.stringify({requests:[{addSheet:{properties:{title:'transactions',gridProperties:{rowCount:1100,columnCount:26}}}}]}),muteHttpExceptions:true});if(createRes.getResponseCode()>=300)throw {message:'สร้างตารางรายรับรายจ่ายไม่สำเร็จ',status:503};}}var query=names.map(function(n){return 'ranges='+encodeURIComponent("'"+n+"'!A1:Z1002");}).join('&');var oldRes=UrlFetchApp.fetch('https://sheets.googleapis.com/v4/spreadsheets/'+a.connection.spreadsheetId+'/values:batchGet?'+query,{headers:{Authorization:'Bearer '+p.accessToken},muteHttpExceptions:true});if(oldRes.getResponseCode()>=300)throw {message:'ตรวจข้อมูลเดิมใน Sheets ไม่สำเร็จ',status:503};var oldRanges=JSON.parse(oldRes.getContentText()).valueRanges||[];var updates=[],sizes={};names.forEach(function(name,index){var rows=p.ranges[name];var actual=((oldRanges[index]||{}).values||[]).length;var count=Math.max(rows.length,(a.sizes||{})[name]||0,actual);sizes[name]=rows.length;var cols=rows[0].length;while(rows.length<count)rows.push(Array(cols).fill(''));updates.push({range:"'"+name+"'!A1",values:rows});});var res=UrlFetchApp.fetch('https://sheets.googleapis.com/v4/spreadsheets/'+a.connection.spreadsheetId+'/values:batchUpdate',{method:'post',contentType:'application/json',headers:{Authorization:'Bearer '+p.accessToken},payload:JSON.stringify({valueInputOption:'RAW',data:updates}),muteHttpExceptions:true});if(res.getResponseCode()>=300)throw {message:'บันทึก Google Sheets ไม่สำเร็จ',status:503};a.sizes=sizes;a.revision++;save();return output_({version:a.revision});}
if(action==='push'){current();a.push=p.encryptedSubscription;save();return output_({ok:true});}
if(action==='linkCode'){if(a.authProvider==='line')throw {message:'LINE identity is immutable',status:403};a.linkCode={code:p.code,expires:now+600000};save();return output_({ok:true});}
if(action==='aiQuota'){var day=new Date().toISOString().slice(0,10);if(a.aiLast&&now-a.aiLast<5000)throw {message:'กรุณารอสักครู่ก่อนส่งข้อความถัดไป',status:429};if(a.aiDay!==day){a.aiDay=day;a.aiCount=0;}if((a.aiCount||0)>=30)throw {message:'ใช้ AI ครบ 30 ครั้งสำหรับวันนี้แล้ว',status:429};a.aiLast=now;a.aiCount=(a.aiCount||0)+1;save();return output_({ok:true});}
if(action==='consumeLink'){var match=accounts.filter(function(x){return x.account.linkCode&&x.account.linkCode.code===p.code&&x.account.linkCode.expires>now;})[0];if(!match)throw {message:'รหัสไม่ถูกต้องหรือหมดอายุ',status:400};if(match.account.authProvider==='line')throw {message:'LINE identity is immutable',status:403};var duplicate=accounts.some(function(x){return x.account.uid!==match.account.uid&&x.account.line===p.lineId;});if(duplicate)throw {message:'LINE นี้เชื่อมกับบัญชีอื่นแล้ว',status:409};match.account.line=p.lineId;match.account.linkCode=null;sheet.getRange(match.row,2).setValue(JSON.stringify(match.account));return output_({ok:true});}
if(action==='findLine'){var lineMatch=accounts.filter(function(x){return x.account.line===p.lineId;})[0];return output_(lineMatch?lineMatch.account:null);}
if(action==='claimReminder'){current();a.claims=a.claims||{};var claim=a.claims[p.key];if(claim&&(claim.done||claim.until>now))return output_({claimed:false});if(Object.keys(a.claims).length>2000){Object.keys(a.claims).forEach(function(k){if(a.claims[k].until<now-604800000)delete a.claims[k];});}a.claims[p.key]={until:now+120000,done:false};save();return output_({claimed:true});}
if(action==='finishReminder'){current();a.claims=a.claims||{};a.claims[p.key]={until:now+604800000,done:true};save();return output_({ok:true});}
throw {message:'Unknown action',status:400};
}catch(err){return output_({error:err.message||'Registry error',status:err.status||500});}finally{if(lock.hasLock())lock.releaseLock();}}
function output_(data){return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON);}
// Called only while doPost holds the registry lock. Mutate a single chat row;
// app data, its revision and registry sizes remain untouched.
function saveChat_(account,p){
 var deleting=typeof p.deletedId==='string',row=p.row,id=deleting?p.deletedId:row&&row[0];
 if((deleting&&row)||typeof id!=='string'||!id.trim()||id.length>100||/[\x00-\x1f]/.test(id)||!p.accessToken)throw {message:'Invalid chat',status:400};
 if(!deleting){
  if(!Array.isArray(row)||row.length!==5||typeof row[2]!=='string'||row[2].length>200||typeof row[3]!=='number'||!isFinite(row[3])||row[3]<=0||typeof row[4]!=='string'||row[4].length>45000)throw {message:'Invalid chat',status:400};
  if(row[1]!==account.uid)throw {message:'Chat owner mismatch',status:403};
  try{if(!Array.isArray(JSON.parse(row[4])))throw Error();}catch(err){throw {message:'Invalid chat messages',status:400};}
 }
 var root='https://sheets.googleapis.com/v4/spreadsheets/'+account.connection.spreadsheetId;
 function request(url,payload){var options={headers:{Authorization:'Bearer '+p.accessToken},muteHttpExceptions:true};if(payload){options.method='post';options.contentType='application/json';options.payload=JSON.stringify(payload);}var res=UrlFetchApp.fetch(url,options);if(res.getResponseCode()>=300)throw {message:'บันทึกประวัติใน Google Sheets ไม่สำเร็จ กรุณาลองใหม่',status:503};return JSON.parse(res.getContentText()||'{}');}
 var meta=request(root+'?fields=sheets(properties(title))'),exists=(meta.sheets||[]).some(function(s){return s.properties.title==='chats';});
 if(!exists){if(deleting)return {ok:true};request(root+':batchUpdate',{requests:[{addSheet:{properties:{title:'chats',gridProperties:{rowCount:1100,columnCount:5}}}}]});}
 var rows=((request(root+'/values:batchGet?ranges='+encodeURIComponent("'chats'!A1:E1002")).valueRanges||[])[0]||{}).values||[];
 var header=['id','owner_id','title','updated_at','messages'];
 if(rows.length&&JSON.stringify(rows[0])!==JSON.stringify(header))throw {message:'รูปแบบตารางประวัติไม่ถูกต้อง ระบบจะไม่เขียนทับ',status:409};
 var target=-1,empty=-1;
 for(var i=1;i<rows.length;i++){if(!rows[i][0]&&empty===-1)empty=i;if(rows[i][0]===id){if(rows[i][1]!==account.uid)throw {message:'Chat owner mismatch',status:403};target=i;}}
 if(deleting&&target===-1)return {ok:true};
 if(target===-1)target=empty>=1?empty:Math.max(1,rows.length);
 if(target>1000)throw {message:'ประวัติครบ 1,000 บทสนทนา กรุณาลบรายการเก่าก่อน',status:400};
 var updates=[];if(!rows.length)updates.push({range:"'chats'!A1",values:[header]});
 updates.push({range:"'chats'!A"+(target+1),values:[deleting?['','','','','']:row]});
 request(root+'/values:batchUpdate',{valueInputOption:'RAW',data:updates});return {ok:true};
}
function dayziSchemas_(){return {chats:['id','owner_id','title','updated_at','messages'],app_meta:['key','value'],events:['id','owner_id','title','date','time','end_time','category','status','repeat','reminders','channels','note','location','all_day','file_ids','updated_at'],tasks:['id','owner_id','title','date','done','category'],notes:['id','owner_id','title','content','color','updated_at'],files:['id','owner_id','name','size','mime_type','drive_id','event_id','created_at'],transactions:['id','owner_id','title','type','amount_satang','date','category','note','receipt_hash','source','created_at'],settings:['key','value'],reminders:['key','sent_at']};}

// ค่าลับอ่านจาก Script properties ก่อน ถ้าไม่มีใช้ค่าจากไฟล์ config.gs ที่สร้างตอน deploy
function registrySecret_(props){return props.getProperty('REGISTRY_SECRET')||(typeof DAYZI_REGISTRY_SECRET==='string'?DAYZI_REGISTRY_SECRET:'');}
// สร้างชีตทะเบียนให้อัตโนมัติครั้งแรก แล้วจำรหัสไว้ใน Script properties
function registryBook_(props){var id=props.getProperty('REGISTRY_SHEET_ID');if(id)return SpreadsheetApp.openById(id);var book=SpreadsheetApp.create('Dayzi Registry');props.setProperty('REGISTRY_SHEET_ID',book.getId());return book;}
// กด Run ฟังก์ชันนี้หนึ่งครั้งในหน้า editor เพื่ออนุญาตสิทธิ์ Sheets/Drive ให้ web app
function authorize(){registryBook_(PropertiesService.getScriptProperties());DriveApp.getRootFolder();return 'ok';}
