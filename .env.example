# Server-only values: set in Vercel project environment variables. Never paste secrets into the app URL inputs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PICKER_API_KEY=
GOOGLE_PROJECT_NUMBER=
SESSION_SECRET=
# 32 random bytes encoded as base64
TOKEN_ENCRYPTION_KEY=
REGISTRY_URL=
REGISTRY_SECRET=
REMINDER_WORKER_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# Include the @, for example @yourbot
LINE_BOT_ID=@yourbot
# LINE Login channel must belong to the same LINE provider as Messaging API.
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# Optional: exact hostname of an explicitly configured HTTPS tunnel, webhook ingress only.
LOCAL_LINE_WEBHOOK_HOST=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Gemini: create a server key in Googl
e AI Studio. For local use put it in .env.local.
# Never name this VITE_GEMINI_API_KEY: VITE_ values are public in the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Vercel AI Gateway may also inject GEMINI_API_KEY and GOOGLE_GEMINI_BASE_URL at runtime.
